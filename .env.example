# Where forms send their messages (any service that accepts a JSON POST).
# Leave these empty to run in demo mode: forms validate and show their success state but send nothing.

# Quote requests from the Garden builder.
VITE_QUOTE_ENDPOINT=

# Messages from the "Say hello" form in the contact section. Falls back to VITE_QUOTE_ENDPOINT if empty.
VITE_CONTACT_ENDPOINT=
